# Copy to .env.local for local development. Never commit real values.
# In GitHub, add these under Settings → Secrets and variables → Actions → Variables.

# Web3Forms access key (https://web3forms.com) — enables the contact form.
# Leave empty and the form will say it is not connected and show the email address instead.
VITE_WEB3FORMS_ACCESS_KEY=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Optional.
# Analytics only loads after a visitor accepts analytics cookies.
VITE_GA_MEASUREMENT_ID=
